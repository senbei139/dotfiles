#!/bin/zsh
#
# tmux のウィンドウを fzf であいまい検索して切り替える。
# prefix + w から display-popup 経由で呼ばれる switch 画面。
#
# 全セッションのウィンドウを 1 つの平坦なリストにするので、セッションをまたいだ移動も
# そのまま選べる。並びは最近使った順。右のプレビューには選択中のウィンドウの実画面を出す
# (choose-tree の -O time とプレビューの代わり)。
#
# ここは一覧と移動だけを担う。リネーム・新規作成・削除は prefix のキー (c / t / r) と
# tmux 標準のキーを直接使う。
#
# 操作は vim 風のモーダル。通常モードは j/k で移動、/ で検索モードに入る。
#
# 色は .tmux.conf のパレットに揃える (選択行 = ティール = 選択中)。

emulate -L zsh

# fzf の reload から自分を呼び直すので、シンボリックリンクを解決した実体を持つ
local self=${0:A}

# 行ごとに色を付けると、選択行を反転させたときに文字色が背景に埋もれる
# (青 #6A90CD on ティール #5FA3A3 で 1.1:1)。選択中はティールのポインタで示す
local FZF_COLORS='bg+:-1,fg+:-1,hl:#24C1E0,hl+:#24C1E0,prompt:#6A90CD,pointer:#5FA3A3,info:#5F6368,border:#5F6368,header:#5F6368'

# 1 列目に切り替え先 (session:index) を隠し持たせ、表示は 2 列目だけにする。
# セッションを独立した列にして罫線で区切り、階層が一目で分かるようにする。
# 色は .tmux.conf のパレットをそのまま使う (セッション名 = 青。フッターと同じ扱い)
# 並びは #{window_activity} の降順 = 最近使った順 (choose-tree の -O time と同じ基準)
list_windows() {
  # 生成 AI の状態はウィンドウごとに 1 文字で出す (記号と色は tmux-agent-state と揃える)
  local -A state
  local tgt st
  while IFS=$'\t' read -r tgt st; do
    [[ -n $tgt ]] && state[$tgt]=$st
  done < <(${self:h}/tmux-agent-state windows 2>/dev/null)

  local BLUE=$'\033[38;2;106;144;205m'
  local GREEN=$'\033[38;2;52;168;83m'    YELLOW=$'\033[38;2;251;188;4m'
  local BRIGHT=$'\033[38;2;232;234;237m' DIM=$'\033[38;2;95;99;104m'
  local OFF=$'\033[0m'
  # 状態は色だけで表す (記号は tmux-agent-state と揃えて ● に固定)
  local -A GLYPH=(blocked '●' working '●' done '●' idle '●')
  local -A COLOR=(blocked $BLUE working $YELLOW done $GREEN idle $DIM)

  # ウィンドウ名には会話タイトル (日本語・空白・記号あり) が入るので、区切りには
  # そこに現れない制御文字を使う
  local SEP=$'\x1f'
  local activity session name cwd agent
  tmux list-windows -a -F "#{window_activity}${SEP}#{session_name}:#{window_index}${SEP}#{session_name}${SEP}#{=/24/…:#{window_name}}${SEP}#{pane_current_path}" |
    sort -t"$SEP" -k1,1 -rn |
    while IFS="$SEP" read -r activity tgt session name cwd; do
      cwd=${cwd/#$HOME/\~}
      st=${state[$tgt]}
      [[ -n $st ]] && agent="${COLOR[$st]}${GLYPH[$st]}${OFF}" || agent=' '
      # 桁揃えは表示幅で行う。awk の printf や ${#str} はバイト数で数えるため、
      # 日本語のウィンドウ名が来ると列がずれる (zsh の m フラグは表示幅で数える)
      printf '%s\t%s%s%s%s│%s %s %s%s%s %s%s%s\n' \
        "$tgt" "$BLUE" "${(mr:10:: :)session}" "$OFF" "$DIM" "$OFF" \
        "$agent" "$BRIGHT" "${(mr:24:: :)name}" "$OFF" "$DIM" "$cwd" "$OFF"
    done
}

# サブコマンド: fzf の中から呼ばれる側
if [[ $1 == --list ]]; then
  list_windows
  exit 0
fi

# vim 風のモーダル操作にする。通常モードでは文字キーをクエリに入れず j/k の移動を優先し、
# / を押したときだけ検索できるようにする (モードの判別にはプロンプトの文字列を使う)
local -a printable ignores
local ch
printable=({a..z} {A..Z} {0..9} space)
for ch in $printable; do
  # 通常モードでコマンドとして使うキーは殺さない
  [[ $ch == (j|k|g|G|q) ]] && continue
  ignores+=("$ch:ignore")
done
local typing_keys="${(j:,:)printable},/"

# 先頭は今いるウィンドウなので、そのままだと Enter が空振りになる。
# 1 つ下から始めて「直前に使っていたウィンドウへ戻る」を Enter だけでできるようにする
local list start_bind
list=$(list_windows)
if [[ ${list%%$'\t'*} == $(tmux display-message -p '#{session_name}:#{window_index}') \
      && ${#${(f)list}} -gt 1 ]]; then
  # start はリスト読み込み前に発火して効かないので load を使う。
  # load は reload のたびに来るので、一度動かしたら自分を外す
  start_bind='load:down+unbind(load)'
else
  start_bind='load:ignore'
fi

local target
target=$(
  print -r -- "$list" |
  fzf --delimiter=$'\t' --with-nth=2 --no-multi --reverse --height=100% --ansi \
      --prompt='window > ' --info=inline \
      --header=$'j/k move    /  search    q quit' \
      --bind="${(j:,:)ignores}" \
      --bind='j:down,k:up,g:first,G:last,q:abort' \
      --bind="$start_bind" \
      --bind="/:unbind($typing_keys)+change-prompt(/)" \
      --bind="esc:transform:if [[ \$FZF_PROMPT == '/' ]]; then echo 'rebind($typing_keys)+change-prompt(window > )+clear-query'; else echo abort; fi" \
      --preview='tmux capture-pane -ep -t {1}' \
      --preview-window='right,50%,border-left' \
      --color="$FZF_COLORS"
) || exit 0

# fzf を抜けただけのときは何もしない
[[ -n $target ]] || exit 0

tmux switch-client -t "${target%%$'\t'*}"
